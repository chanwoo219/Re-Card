{
  "info": {
    "name": "re:card API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "서버 실행 후 폴더 순서대로 실행하면 모든 API를 테스트합니다. 앞 요청에서 만든 id를 다음 요청이 이어받습니다."
  },
  "item": [
    {
      "name": "User",
      "item": [
        {
          "name": "1. 사용자 생성 (A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('상태 코드 201', () => pm.response.to.have.status(201));",
                  "pm.test('success true', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.collectionVariables.set('userA', pm.response.json().data.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('suffix', String(Date.now()).slice(-6));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"userA_{{suffix}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
